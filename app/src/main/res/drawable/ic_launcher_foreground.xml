<?xml version="1.0" encoding="utf-8"?>
<!-- Meltorama 2000: a neon droplet mid-melt, sunk into a milled chrome
     bezel with the horizon running behind it — the app's own ChromeButton,
     shrunk to a launcher. Hand-authored vector; the droplet is
     deliberately lopsided, because perfect circles are for serious apps.

     The bezel is a real gradient (VectorDrawable <gradient>, native since
     API 24; minSdk here is 26): flat two-tone rings read as a sticker,
     and chrome is exactly the material that lives or dies by its
     gradient. Light comes from the upper left, as everywhere else in the
     design system.

     Everything sits inside the adaptive-icon safe zone (the centre 72dp
     of 108dp): the bezel's outer radius is 34, so circle, squircle and
     rounded-square masks all keep the whole subject. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Milled bezel. -->
    <path android:pathData="M54,20 a34,34 0 1,0 0.1,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="26" android:startY="26"
                android:endX="82" android:endY="82">
                <item android:offset="0.0" android:color="#F2F7FF" />
                <item android:offset="0.30" android:color="#9DAFD2" />
                <item android:offset="0.52" android:color="#4A5678" />
                <item android:offset="0.74" android:color="#A9BADB" />
                <item android:offset="1.0" android:color="#E8F0FC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The recess the droplet sits in, with its own inner shadow ring. -->
    <path
        android:fillColor="#1E2540"
        android:pathData="M54,24 a30,30 0 1,0 0.1,0 Z" />
    <path
        android:fillColor="#080A16"
        android:pathData="M54,26 a28,28 0 1,0 0.1,0 Z" />

    <!-- Horizon behind the droplet: the grid, one line of it. -->
    <path
        android:fillColor="#35E3F2"
        android:fillAlpha="0.8"
        android:pathData="M28,66 L80,66 L80,68 L28,68 Z" />

    <!-- Droplet, mid-melt: a heavy sagging body with one drip running off
         the bottom left, where the shape is already lowest. -->
    <path
        android:fillColor="#FF3D9E"
        android:pathData="M54,32 C64,32 71,39 71,48 C71,56 66,60 67,66 C68,73 61,78 53,78 C45,78 39,74 40,67 C41,60 37,56 37,48 C37,39 44,32 54,32 Z" />
    <path
        android:fillColor="#FF3D9E"
        android:pathData="M46,74 C49,74 50,78 49,82 C48,85 45,85 44,82 C43,79 43,74 46,74 Z" />
    <!-- Darker underside: volume, and the sag reading as weight. -->
    <path
        android:fillColor="#C42A78"
        android:pathData="M67,58 C67,66 62,74 53,75 C45,76 40,72 40,67 C44,72 49,73 55,71 C61,69 65,64 67,58 Z" />
    <!-- Gloss: the one highlight that says "wet". -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.72"
        android:pathData="M46,40 C51,37 58,37 62,40 C65,42 62,45 57,45 C52,45 48,46 46,45 C43,44 43,41 46,40 Z" />
</vector>
