<resources>
    <!-- The single user-visible source of the app name (PLAN.md "Renaming").
         SHORT form on purpose: this is the launcher label, where Android
         gives about 12 characters before it ellipsizes. The full name is
         [app_name_full] + [app_model], set as a lockup on the In screen.
         Untranslatable: the wordmark is the product's name, not a phrase,
         so it stays Meltorama 2000 in every language. -->
    <string name="app_name" translatable="false">Meltorama</string>
    <string name="app_name_full" translatable="false">MELTORAMA</string>
    <string name="app_model" translatable="false">2000</string>

    <string name="home_tagline">GOO YOUR PHOTOS</string>
    <string name="home_subtagline">Squish, smear and stretch your photos\nlike wet paint.</string>
    <string name="home_enter_goo">GOO!</string>
    <string name="home_samples_label">No photo handy? Goo a sample:</string>
    <string name="sample_goo_guy">Sample: Goo Guy</string>
    <string name="sample_candy_blobs">Sample: Candy Blobs</string>

    <!-- Saved projects on the In screen. "Hold to throw away" is the only
         place the long press is announced, so it stays in the label.
         A tile is a goo, not a "screen": the bezel is how it is drawn,
         but what the user holds is their work. -->
    <string name="home_projects_label">Pick up where you left off — hold a goo to throw it away:</string>
    <!-- The shelf's instrument readout. Nothing evicts on its own, so
         these are the numbers the user's own decision is made on: what is
         there, what it costs, and what is left. -->
    <plurals name="home_projects_usage">
        <item quantity="one">%1$d goo · %2$s used · %3$s free</item>
        <item quantity="other">%1$d goos · %2$s used · %3$s free</item>
    </plurals>
