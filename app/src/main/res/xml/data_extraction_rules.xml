<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ backup/transfer rules; mirrors backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
