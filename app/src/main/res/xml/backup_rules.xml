<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup (API 26-30 path). Settings are tiny and harmless to back
     up; nothing sensitive exists in this app (no accounts, no keys).

     Deliberately an allowlist, which is what answers ANALYSIS SOL-20's
     "decide backup behavior with SOL-34": saved projects (files/projects)
     hold the user's PHOTOS, and the app's promise is that nothing leaves
     the device. They stay out of cloud backup and off device transfer —
     an uninstall takes them with it, and that is the honest trade. -->
<full-backup-content>
    <include domain="file" path="datastore" />
    <include domain="sharedpref" path="." />
</full-backup-content>
