<?xml version="1.0" encoding="utf-8"?>
<!-- No permissions, deliberately: the app is fully offline (PLAN.md §5.2).
     Photos come in through the system Photo Picker (no storage permission)
     and go out through MediaStore inserts (no permission on API 29+; the
     26-28 legacy save path is scoped to app-owned collections).

     The camera is the same bargain. ACTION_IMAGE_CAPTURE hands the job to
     whatever camera app the user already has, so Meltorama never touches
     the camera and never asks for CAMERA. Declaring that permission would
     make things WORSE, not better: Android then requires it to be granted
     before the action will run at all. See CameraCapture. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Package visibility (API 30+), not a permission: without this the
         camera intent cannot be RESOLVED, only launched, so the Snap
         button could not be hidden on a device with no camera app and
         would throw when tapped instead. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".GooApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Meltorama"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves the share cache to the apps the user picks in the share
             sheet; nothing else is exported (see xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
